    "@CMAKE_PROJECT_NAME@": "@CMAKE_CURRENT_BINARY_DIR@/doxygen/xml",
}
breathe_default_project = "@CMAKE_PROJECT_NAME@"

# ---------------------------------------------------------------------------
# Exhale — auto-generates the C++ API RST tree from the Breathe/Doxygen data
# ---------------------------------------------------------------------------
exhale_args = {
    # Folder (relative to this conf.py) where Exhale writes its RST files.
    "containmentFolder": "./api",
    "rootFileName": "library_root.rst",
    "rootFileTitle": "C++ API Reference",
    # Strip the source-tree prefix from displayed file paths.
    "doxygenStripFromPath": "@CMAKE_SOURCE_DIR@",
    # We run Doxygen ourselves via CMake, so tell Exhale not to re-run it.
    "exhaleExecutesDoxygen": False,
    # Create a collapsible tree view in the sidebar.
    "createTreeView": True,
}

exclude_patterns = ["_build", "Thumbs.db", ".DS_Store"]

# By default Breathe skips functions defined in .cpp/.c files on the assumption
# that they are documented via their header declaration.  Our file-static helpers
# (e.g. parseChannelArgumentList) have no header, so we clear the exclusion list.
breathe_implementation_filename_extensions = []


# ---------------------------------------------------------------------------
# Workaround: breathe's generated compoundsuper.py has a bug where
# docSect2Type.__init__ assigns to a local "title" variable instead of
# "self.title" (unlike docSect1Type/docSect3Type, which set self.title = ""
# by default). Doxygen >= 1.16 emits untitled <sect1>/<sect2> wrappers around
# markdown pages that start at heading level 3 (e.g. the mlir-tblgen
# generated *Passes.md pages), so breathe ends up with a docSect2Type that
# has no "title" attribute at all, and visit_docsectN raises AttributeError.
# Default title to "" in that case, same as docSect1Type/docSect3Type. This
# is a no-op whenever <title> is present, so older Doxygen versions (which
# don't emit titleless <sect2> elements) are unaffected.
# ---------------------------------------------------------------------------
from breathe.parser import compoundsuper as _compoundsuper

_orig_docSect2Type_init = _compoundsuper.docSect2Type.__init__


def _docSect2Type_init(self, *args, **kwargs):
    _orig_docSect2Type_init(self, *args, **kwargs)
    if not hasattr(self, "title"):
        self.title = ""


_compoundsuper.docSect2Type.__init__ = _docSect2Type_init


# ---------------------------------------------------------------------------
# Source-read hook: strip [TOC] markers emitted by mlir-tblgen --gen-dialect-doc
# ---------------------------------------------------------------------------
def _strip_toc_markers(app, docname, source):
    source[0] = source[0].replace("[TOC]\n", "").replace("[TOC]", "")


# ---------------------------------------------------------------------------
# Source-read hook: title the mlir-tblgen generated docs/Passes/*.md pages.
# They start directly at heading level 3 (one "###" per pass), so without a
# title the individual passes end up as flat siblings under the "Passes"
# toctree caption instead of being grouped under a per-dialect heading in
# the sidebar. The title is derived from the docname (splitting on CamelCase
# word boundaries, keeping runs of capitals like "DFG"/"HLS" together), so
# new *Passes.md files added to the Passes/ toctree are titled automatically.
# ---------------------------------------------------------------------------
_CAMEL_WORD_RE = re.compile(r"[A-Z]+(?=[A-Z]|$)|[A-Z]?[a-z]+")


def _add_pass_doc_titles(app, docname, source):
    if not docname.startswith("Passes/") or source[0].lstrip().startswith("#"):
        return
    name = docname.rsplit("/", 1)[-1]
    title = " ".join(_CAMEL_WORD_RE.findall(name))
    source[0] = f"# {title}\n\n" + source[0]


def setup(app):
    app.connect("source-read", _strip_toc_markers)
    app.connect("source-read", _add_pass_doc_titles)

# Serve the logo images at the same relative paths that README.md references
# them with: <picture> srcset="docs/LAKSA-Dark.png" / "docs/LAKSA-Light.png".
# html_extra_path copies the *contents* of the listed directory to the root
# of the HTML output (it drops the "docs" folder name), so docs/CMakeLists.txt
# nests the images one level deeper (build dir: docs/docs/LAKSA-{Dark,Light}.png)
# so that the surviving "docs/" component lands at the right place:
# <output>/docs/LAKSA-{Dark,Light}.png.
html_extra_path = ["docs"]

# Generated docs don't follow the reader's OS color scheme the way GitHub's
# README rendering does, so the sidebar logo is pinned to the dark variant
# rather than using the <picture> light/dark switch from README.md.
# html_logo = "LAKSA-Dark.png"
